# Channel + policy wiring. Copy to .env and fill in — real values never committed.

# ── Sender policy (security/guest_sandbox.py) ─────────────────────────
# The trusted operator: full toolsets. REQUIRED.
HOUSEHOLD_OWNER_ID=

# Optional restricted contact: minimal toolset + command allowlist only.
HOUSEHOLD_PRIVATE_ID=
# The isolated routing profile the restricted contact must match (fail closed).
HOUSEHOLD_PRIVATE_PROFILE=

# ── Channel adapter ───────────────────────────────────────────────────
# Webhook / API credentials for the WhatsApp Cloud API gateway adapter.
# Names vary by provider — examples shown.
CHANNEL_API_KEY=
CHANNEL_WEBHOOK_SECRET=
CHANNEL_PHONE_NUMBER_ID=

# Allowlisted guest senders (comma-separated), managed by the owner.
GUEST_ALLOWED_SENDERS=

# ── Commerce integration (MCP) ────────────────────────────────────────
COMMERCE_MCP_ENDPOINT=
COMMERCE_MCP_TOKEN=
